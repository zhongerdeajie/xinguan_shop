# School System V3 - Environment Variables
# 复制本文件为 .env 并填入真实值；.env 已被 git 忽略

# ===== 数据库 =====
MYSQL_PASSWORD=请改成强密码（仅字母数字，避免 URL 解析问题）
MYSQL_HOST_PORT=3307

# ===== 认证 =====
JWT_SECRET=请改成随机长字符串

# ===== AI =====
ZHIPU_API_KEY=sk-请填写你的智谱Key
LLM_MODEL=qwen3.7-max-2026-05-20
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.3
AI_SERVICE_USERNAME=admin
AI_SERVICE_PASSWORD=123456

# ===== 网关 =====
NGINX_PORT=80

# ===== Go 服务（一般不用改）=====
GO_PORT=8081
GIN_MODE=release
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_DATABASE=starselect

# ===== NestJS（docker-compose 内部已配置，本地开发可参考）=====
DATABASE_URL=mysql://root:你的密码@localhost:3306/starselect
AI_SERVICE_URL=http://localhost:5000

# ===== Next.js（docker-compose 内部已配置）=====
INTERNAL_API_URL=http://nestjs-api:3000
