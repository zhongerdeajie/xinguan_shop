# ============================================
# 星选 AI 购物管家 - 环境变量模板
# ============================================
#
# 用法：
#   1. cp .env.example .env
#   2. 把所有 <填入xxx> 占位符替换成真实值
#   3. .env 已被 .gitignore 忽略，绝不要 commit 进 git
#
# 字段命名：
#   - 必填：必须替换占位符
#   - 一般不用改：Docker 模式下由 docker-compose.yml 自动注入
#
# ============================================
# 【安全红线】
# 不要把任何真实 API Key / 密码 / JWT_SECRET 写回本文件后 commit！
# GitHub 会对公开仓库自动跑 Secret Scanning：
#   - 真实 key 一旦进入 git 历史，会被自动作废
#   - 即使删除提交，历史里仍残留，无法彻底清除
# ============================================

# ===== 数据库（必填） =====
MYSQL_PASSWORD=<填入强密码，16-24 字符字母数字>
MYSQL_HOST_PORT=3307

# ===== JWT 签名密钥（必填） =====
# 用于顾客/管理员 token 签名与验签，建议 64 字符随机
JWT_SECRET=<填入 64 字符随机字符串，建议 openssl rand -hex 32>

# ===== AI 大模型 - 智谱（必填） =====
# 用途：AI 点餐助手的对话与 6 个 Agent 的推理
ZHIPU_API_KEY=<填入智谱 API Key，格式 sk-xxx.xxx>
AI_SERVICE_USERNAME=admin
# AI 服务调用 Go 服务时的密码；与 SEED_ADMIN_PASSWORD 保持完全一致
AI_SERVICE_PASSWORD=<填入强密码，建议 openssl rand -base64 12>

# ===== 管理员种子密码（必填，与 AI_SERVICE_PASSWORD 保持一致）=====
# 用途：NestJS 启动时自动灌入 admin 账号的明文密码
# Python AI 登录 NestJS 用 AI_SERVICE_PASSWORD，两者必须相同
SEED_ADMIN_PASSWORD=<填入与 AI_SERVICE_PASSWORD 相同的强密码>

# ===== Embedding 向量服务 - MiniMax（必填） =====
# 用途：把知识库文档转成 1536 维向量，用于 RAG 语义检索
EMBEDDING_PROVIDER=minimax
MINIMAX_API_KEY=<填入 MiniMax API Key，格式 sk-xxx>
MINIMAX_EMBEDDING_MODEL=embo-01
MINIMAX_EMBEDDING_URL=https://api.minimaxi.com/v1/embeddings
EMBEDDING_DIM=1536

# ===== 网关端口（必填） =====
# 服务器用 80；本地开发用 8090 避免和系统 Nginx / skymall 冲突
NGINX_PORT=80

# ===== Go 服务（Docker 模式下一般不用改） =====
# 这些字段在 Docker 内部会被 docker-compose.yml 自动覆盖；
# 仅在宿主机裸跑 go-service 时使用
GO_PORT=8081
GIN_MODE=release
# Docker 内用容器名 redis；宿主机裸跑改 localhost:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
# Docker 内用容器名 mysql；宿主机裸跑改 localhost
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_DATABASE=starselect

# ===== NestJS（Docker 模式下一般不用改） =====
DATABASE_URL=mysql://root:${MYSQL_PASSWORD}@mysql:3306/starselect
AI_SERVICE_URL=http://python-ai:5000

# ===== Next.js（Docker 模式下一般不用改） =====
INTERNAL_API_URL=http://nestjs-api:3000