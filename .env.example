# ============================================
# 环境变量模板（复制为 .env 后填实际值）
# .env 已被 .gitignore 忽略，绝不要提交到 git
# ============================================

# 数据库（生产环境必须用强密码）
MYSQL_PASSWORD=change-me-to-strong-password
MYSQL_HOST_PORT=3307

# JWT 签名密钥（必须 ≥16 字符的随机字符串，例：openssl rand -hex 32）
JWT_SECRET=change-me-to-strong-random-string

# 智谱 AI Key —— 在 https://bigmodel.cn/usercenter/apikeys 重新生成后填入
ZHIPU_API_KEY=replace-with-new-zhipu-key

# AI 服务调用 Go 时使用的登录账号（默认与种子数据的管理员一致）
AI_SERVICE_USERNAME=admin
AI_SERVICE_PASSWORD=123456

# 统一入口网关端口（本地用 8090，服务器上改成 80）
NGINX_PORT=8090

# ===== MiniMax Embedding (embo-01, 1536 dim) =====
# 在 https://platform.minimaxi.com/user-center/basic-information/interface-key 重新生成
EMBEDDING_PROVIDER=minimax
MINIMAX_API_KEY=replace-with-new-minimax-key
MINIMAX_EMBEDDING_MODEL=embo-01
MINIMAX_EMBEDDING_URL=https://api.minimaxi.com/v1/embeddings
EMBEDDING_DIM=1536